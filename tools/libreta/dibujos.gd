func _init() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(SALIDA + "silueta"))
	var avisos := 0
	for id: String in DIBUJOS:
		var filas: Array = DIBUJOS[id]
		var alto := filas.size()
		var img := Image.create(ANCHO * ESCALA, alto * ESCALA, false, Image.FORMAT_RGBA8)
		var sombra := Image.create(ANCHO * ESCALA, alto * ESCALA, false, Image.FORMAT_RGBA8)
		for y in alto:
			var fila: String = filas[y]
			if fila.length() != ANCHO:
				print("aviso: %s renglon %d mide %d (no %d)" % [id, y, fila.length(), ANCHO])
				avisos += 1
				fila = fila.rpad(ANCHO, ".").substr(0, ANCHO)
			for x in ANCHO:
				var c := fila[x]
				if c == "." or c == "|":
					if c == "|":
						_cuadro(img, x, y, PALETA["k"])
						_cuadro(sombra, x, y, SOMBRA)
					continue
				_cuadro(img, x, y, PALETA.get(c, PALETA["k"]))
				_cuadro(sombra, x, y, SOMBRA)
		img.save_png(SALIDA + id + ".png")
		sombra.save_png(SALIDA + "silueta/" + id + ".png")
		print("  -> %s%s.png" % [SALIDA, id])
	print("listo, %d avisos" % avisos)
	quit()


func _cuadro(img: Image, x: int, y: int, color: Color) -> void:
	img.fill_rect(Rect2i(x * ESCALA, y * ESCALA, ESCALA, ESCALA), color)
