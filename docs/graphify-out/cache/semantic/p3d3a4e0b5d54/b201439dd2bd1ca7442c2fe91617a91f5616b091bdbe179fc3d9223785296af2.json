{"nodes": [{"id": "revision_historia_documento", "label": "Guadalajaja \u2014 Revisi\u00f3n de la historia", "file_type": "document", "source_file": "revision-historia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "revision_historia_lo_decidido", "label": "Lo decidido (JJ, 2026-11-02)", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "Lo decidido", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "revision_historia_veredicto_corto", "label": "El veredicto corto", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "0. El veredicto corto", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La premisa aguanta todas las pruebas; el horror est\u00e1 bien ordenado; la s\u00e1tira sabe a qui\u00e9n le pega; arreglar primero los cinco choques"}, {"id": "revision_historia_choque_gotera_venden_agua", "label": "1.1 Los Gotera nunca venden agua pero son due\u00f1os de la toma", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decidido: la v\u00e1lvula cerrada es su seguro de vida contra GelA; nunca venden agua"}, {"id": "revision_historia_choque_zombis_beben", "label": "1.2 \u00bfLos zombis beben o no?", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "1.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decidido: beben pero no les sirve; nunca se llenan ni se curan"}, {"id": "revision_historia_choque_final_verdad", "label": "1.3 El final de la verdad choca con el tema", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "1.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decidido: no hay final (sandbox); la ciudad cambia por zona agua \u2192 enojo \u2192 verdad \u2192 GelA contesta"}, {"id": "revision_historia_choque_pista_5", "label": "1.4 La pista 5 no es la misma en lore y misiones", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "1.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decidido: la pista 5 es la presa llena y el filtro; el cobalto es misi\u00f3n aparte de Elena"}, {"id": "revision_historia_choque_nocturno_bot\u00edn", "label": "1.5 El Nocturno, el bot\u00edn y la cacer\u00eda", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "1.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decidido: contrabandista por necesidad, sin secreto fijo; la cacer\u00eda es la excepci\u00f3n"}, {"id": "revision_historia_idea_que_controla", "label": "2.1 La idea que controla la historia y su contraria", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La libertad vuelve cuando el agua se comparte, porque solo el que no depende puede enojarse; contraria: el orden gana porque la gente con sed prefiere agradecer que pelear"}, {"id": "revision_historia_r\u00e9gimen_no_reacciona", "label": "2.2 El r\u00e9gimen no reacciona al jugador", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decidido: respuesta en escalones hasta contratarte"}, {"id": "revision_historia_grieta_familia", "label": "Grieta en la familia Lazcano (capilla)", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Germ\u00e1n quiere que recen a la Virgen del Tinaco y Gela la teme"}, {"id": "revision_historia_arco_nocturno", "label": "2.3 El arco del Nocturno (mentira y verdad)", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mentira: 'Yo nom\u00e1s cobro. No es mi pleito.' Verdad: 'Yo tambi\u00e9n tomo de esa agua.'"}, {"id": "revision_historia_tres_motivos", "label": "2.4 Tres motivos (la cartera, el tinaco, la Gota)", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pendiente: la cartera es el m\u00e1s fuerte; la hoja de conteo son las carteras que juntaste"}, {"id": "revision_historia_secretos_repetidos", "label": "3.1 Cinco personajes tienen el mismo secreto", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pendiente: dejar 'toma de la llave' a Beto y Yolanda; cambiar Lalo y Sergio"}, {"id": "revision_historia_secreto_gerardo", "label": "3.2 Gerardo no tiene secreto: tiene algo que no sabe", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pendiente: 'Ya firm\u00f3 algo que no ley\u00f3'"}, {"id": "revision_historia_chuy_gente_apagarse", "label": "3.3 El padre Chuy vio a su gente apagarse", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El Serenol vuelve d\u00f3cil; decidido cambiar 'violenta' por 'apagarse'"}, {"id": "revision_historia_yolanda_amanecer_mansa", "label": "3.4 Volverse chola \u2192 amanecer mansa", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decidido: 'chola' no es del lenguaje de la calle"}, {"id": "revision_historia_detalles", "label": "4. Detalles (los diez)", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "4. Detalles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decididos: fechas, 'los dejamos salir' como giro, GelA Total sin Serenol, Botarga de la Gota, Sof\u00eda, el jefe que era alguien"}, {"id": "revision_historia_los_dejamos_salir", "label": "4.3 'Los guardamos' vs 'los dejamos salir'", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A prop\u00f3sito: la oficial es 'los guardamos'; la del velador es la verdadera; Contenci\u00f3n los suelta porque el miedo conviene"}, {"id": "revision_historia_botarga_de_la_gota", "label": "4.8 Botarga de la Gota (antes Botarga del Simi)", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "4.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ninguna empresa real aparece en el lore"}, {"id": "revision_historia_jefe_que_era_alguien", "label": "4.10 El jefe de la partida es alguien", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "4.10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El zombi es v\u00edctima, no villano: el jefe lleva la credencial de alguien del reparto (Beto si muri\u00f3)"}, {"id": "revision_historia_qu\u00e9_se_puede_quitar", "label": "5. \u00bfQu\u00e9 se puede quitar?", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Villalobos se junta con Arturo; Karla es los ojos del obispo; el de las cruces queda de sabor"}, {"id": "revision_historia_qu\u00e9_decidir_primero", "label": "6. Qu\u00e9 decidir primero", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orden: zombis beben, Gotera y v\u00e1lvula, verdad y cura, idea, respuesta del r\u00e9gimen, detalles"}, {"id": "revision_historia_botiqu\u00edn_del_simi", "label": "Botiqu\u00edn del Simi (marca real en items)", "file_type": "rationale", "source_file": "revision-historia.md", "source_location": "Lo decidido", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pendiente: tambi\u00e9n lleva una marca real (lore \u00a718)"}], "edges": [{"source": "revision_historia_documento", "target": "personajes_documento", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "revision-historia.md", "source_location": null, "weight": 1.0}, {"source": "revision_historia_documento", "target": "lore_documento", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "revision-historia.md", "source_location": null, "weight": 1.0}, {"source": "revision_historia_documento", "target": "misiones_guadalajaja_misiones", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "revision-historia.md", "source_location": null, "weight": 1.0}, {"source": "revision_historia_documento", "target": "revision_historia_lo_decidido", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "revision-historia.md", "source_location": null, "weight": 1.0}, {"source": "revision_historia_documento", "target": "revision_historia_veredicto_corto", "relation": "references", "confidence": "EXTRACTED", "confiden