[gd_resource type="Resource" script_class="MisionData" format=3]

[ext_resource type="Script" path="res://scripts/MisionData.gd" id="1_mision"]
[ext_resource type="Script" path="res://scripts/PasoMision.gd" id="2_paso"]
[ext_resource type="Script" path="res://scripts/InventoryItemData.gd" id="4_item"]
[ext_resource type="Resource" path="res://resources/productos/galon_agua.tres" id="3_galon"]

[sub_resource type="Resource" id="paso_defender"]
script = ExtResource("2_paso")
tipo = 8
cuando = 1
texto = "Aguanta con el tinaco hasta el amanecer"
lugar = "casas"
escena = "res://scenes/defensa_tinaco.tscn"

[resource]
script = ExtResource("1_mision")
id = "defender_tinaco"
nombre = "Defender el tinaco"
modelo = "hombre_psx"
oferta = "Armamos una barricada con el tinaco. Aguante la noche y le toca agua y paga."
aceptada = "Cuando oscurezca, vaya. Los vecinos ya dejaron todo listo."
recuerda = "De noche, a la barricada. Que no se rompa el tinaco."
despedida = "El tinaco aguantó. Ahí tiene su parte."
pasos = Array[ExtResource("2_paso")]([SubResource("paso_defender")])
pesos = 150
premios = Array[ExtResource("4_item")]([ExtResource("3_galon")])
