[gd_resource type="Resource" script_class="MisionData" format=3]

[ext_resource type="Script" path="res://scripts/MisionData.gd" id="1_mision"]
[ext_resource type="Script" path="res://scripts/PasoMision.gd" id="2_paso"]
[ext_resource type="Script" path="res://scripts/InventoryItemData.gd" id="3_item"]
[ext_resource type="Resource" path="res://resources/productos/jarritos.tres" id="4_jarritos"]
[ext_resource type="Resource" path="res://resources/productos/cangurera.tres" id="5_cangurera"]

[sub_resource type="Resource" id="paso_comprar"]
script = ExtResource("2_paso")
tipo = 0
texto = "Compra 2 Jarritos en los abarrotes"
objetos = Array[ExtResource("3_item")]([ExtResource("4_jarritos"), ExtResource("4_jarritos")])
lugar = "giro:abarrotes"

[sub_resource type="Resource" id="paso_entregar"]
script = ExtResource("2_paso")
tipo = 1
texto = "Llévale los Jarritos al del tianguis"
objetos = Array[ExtResource("3_item")]([ExtResource("4_jarritos"), ExtResource("4_jarritos")])

[resource]
script = ExtResource("1_mision")
id = "cangurera"
nombre = "La cangurera del tianguis"
modelo = "cholo"
oferta = "Me muero de sed, compa. Tráeme 2 Jarritos y te rolo una cangurera."
aceptada = "Simón. De los abarrotes, que en el Oxo están carísimos."
recuerda = "¿Y mis Jarritos, compa?"
gracias = "Ahí está. Échale tus tiliches; La Chava del yonke les saca jugo."
despedida = "Ya estuvo, compa. Mañana me paso otra vez."
pasos = Array[ExtResource("2_paso")]([SubResource("paso_comprar"), SubResource("paso_entregar")])
premios = Array[ExtResource("3_item")]([ExtResource("5_cangurera")])
