[gd_resource type="Resource" script_class="MisionData" format=3]

[ext_resource type="Script" path="res://scripts/MisionData.gd" id="1_mision"]
[ext_resource type="Script" path="res://scripts/PasoMision.gd" id="2_paso"]

[sub_resource type="Resource" id="paso_subir"]
script = ExtResource("2_paso")
tipo = 3
texto = "Sube a la azotea del mirador y baja la pelota"
lugar = "marca:Pelota"

[sub_resource type="Resource" id="paso_regresar"]
script = ExtResource("2_paso")
tipo = 1
texto = "Llévale la pelota al profe de la cancha"

[resource]
script = ExtResource("1_mision")
id = "pelota"
nombre = "La pelota en la azotea"
modelo = "psx_man"
oferta = "Los chamacos la volaron a la azotea del mirador. ¿Me la bajas?"
aceptada = "Por la escalera del callejón. No te caigas, eh."
recuerda = "Sin pelota no hay cascarita, joven."
gracias = "¡Eso! Ahora sí, a jugar. Ten, por la ayuda."
despedida = "Ya están jugando. Mañana seguro la vuelven a volar."
pasos = Array[ExtResource("2_paso")]([SubResource("paso_subir"), SubResource("paso_regresar")])
pesos = 50
donde = "marca:Profe_Cancha"
