[gd_resource type="Resource" script_class="MisionData" format=3]

[ext_resource type="Script" path="res://scripts/MisionData.gd" id="1_mision"]
[ext_resource type="Script" path="res://scripts/PasoMision.gd" id="2_paso"]
[ext_resource type="Resource" path="res://resources/misiones/caja_misteriosa.tres" id="3_caja"]

[sub_resource type="Resource" id="paso_llevar"]
script = ExtResource("2_paso")
tipo = 5
cuando = 2
texto = "Lleva la caja a Arroyuelo"
lugar = "punto:punto ARROYUELO"
cuantos = 1
carga = ExtResource("3_caja")
soltable = true

[resource]
script = ExtResource("1_mision")
id = "mafia_3"
nombre = "Entrega a Arroyuelo"
modelo = "gang_member"
donde = "punto:punto ARROYO SECO"
oferta = "Ahí viene el mandadero. Llévate esta a Arroyuelo. Ojo, que pesa más de lo que parece."
aceptada = "Arroyuelo, para el oriente. Si la sueltas para pelear, levántala luego."
recuerda = "La caja va a Arroyuelo."
gracias = "Completita. Don Nemesio va a saber de ti."
despedida = "Ya eres de confianza por aquí."
pasos = Array[ExtResource("2_paso")]([SubResource("paso_llevar")])
pesos = 80
una_vez = true
requiere = "mafia_2"
abierto_de_noche = true
