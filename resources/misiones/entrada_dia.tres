[gd_resource type="Resource" script_class="MisionData" format=3]

[ext_resource type="Script" path="res://scripts/MisionData.gd" id="1_mision"]
[ext_resource type="Script" path="res://scripts/PasoMision.gd" id="2_paso"]

[sub_resource type="Resource" id="paso_entrar"]
script = ExtResource("2_paso")
tipo = 8
cuando = 2
texto = "Llega a la entrada que te marqué"
lugar = "casas"

[resource]
script = ExtResource("1_mision")
id = "entrada_dia"
nombre = "La entrada"
modelo = "mujer_psx"
oferta = "Hay una entrada que quiero que veas. Llega y ya (prueba de ENTRAR_A)."
aceptada = "Ahí le marco el lugar. Llegando, ya es suyo."
recuerda = "Vaya a la entrada que le marqué."
despedida = "Ya vio la entrada. Otro día entramos."
pasos = Array[ExtResource("2_paso")]([SubResource("paso_entrar")])
pesos = 40
