[gd_resource type="Resource" script_class="MisionData" format=3]

[ext_resource type="Script" path="res://scripts/MisionData.gd" id="1_mision"]
[ext_resource type="Script" path="res://scripts/PasoMision.gd" id="2_paso"]

[sub_resource type="Resource" id="paso_medico"]
script = ExtResource("2_paso")
tipo = 4
cuando = 1
texto = "Lleva al herido en la carretilla a la enfermería"
lugar = "clinica"
acompanante = "carretilla"
vida_acompanante = 24

[resource]
script = ExtResource("1_mision")
id = "al_medico_gotera"
nombre = "Al médico"
modelo = "mujer_psx"
donde = "marca:Farmacia_Tianguis"
oferta = "Me trajeron a una persona herida de allá afuera y aquí en el puesto no tengo con qué coserla. Hay una enfermería pasando la reja, la casa de la cruz verde. Llévesela en la carretilla y cuídemela, jefe: de dos golpes no la libra."
aceptada = "Ya oscureció. Ahí está la carretilla: jálela parejo y no se me pare. La cruz verde se ve de lejos."
recuerda = "La enfermería es la casa de la cruz verde, afuera de la reja. No la vaya a soltar."
despedida = "Llegó con vida. Le debo una, jefe. Mañana seguro hay otro herido."
pasos = Array[ExtResource("2_paso")]([SubResource("paso_medico")])
pesos = 100
