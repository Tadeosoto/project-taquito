[gd_resource type="Resource" script_class="MisionData" format=3]

[ext_resource type="Script" path="res://scripts/MisionData.gd" id="1_mision"]
[ext_resource type="Script" path="res://scripts/PasoMision.gd" id="2_paso"]

[sub_resource type="Resource" id="paso_buscar"]
script = ExtResource("2_paso")
tipo = 3
texto = "Busca al perro en la zona marcada: óyelo ladrar"
lugar = "perro"

[sub_resource type="Resource" id="paso_regresar"]
script = ExtResource("2_paso")
tipo = 1
texto = "Regrésale el perro a su dueño"

[resource]
script = ExtResource("1_mision")
id = "perro"
nombre = "Buscar al perro"
modelo = "chava_psx"
oferta = "Se me perdió Firulais. No camina, solo se sienta. Ándale, tráemelo."
aceptada = "Está por ahí, según el mapa. Se oye ladrar."
recuerda = "¿Y Firulais? Óyelo, ladra bien feo."
gracias = "¡Firulais! Toma, esto traía en el hocico: un pedazo de mapa."
despedida = "Firulais ya está en su casa. Sentado."
pasos = Array[ExtResource("2_paso")]([SubResource("paso_buscar"), SubResource("paso_regresar")])
pesos = 60
pieza_de_mapa = true
pesos_si_sobra = 60
